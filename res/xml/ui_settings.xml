<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/something_ui_dashboard_title">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="custom_illustration"
        settings:lottie_rawRes="@raw/custom_illustration"
        android:order="-1001" />

    <PreferenceCategory
        android:key="category_name_qs"
        android:title="@string/category_name_qs">

        <co.aospa.framework.preference.SystemSettingSwitchPreference
            android:key="qs_footer_data_usage"
            android:icon="@drawable/ic_data_usage"
            android:title="@string/qs_show_data_usage_title"
            android:summary="@string/qs_show_data_usage_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_name_power"
        android:title="@string/category_name_power">

        <co.aospa.framework.preference.SystemSettingSwitchPreference
            android:key="advanced_reboot"
            android:icon="@drawable/ic_power"
            android:title="@string/global_actions_advanced_reboot_title"
            android:summary="@string/global_actions_advanced_reboot_summary"
            android:defaultValue="false" />

        <co.aospa.framework.preference.SecureSettingListPreference
            android:key="power_menu_type"
            android:title="@string/power_menu_type_title"
            android:summary="%s"
            android:dialogTitle="@string/power_menu_type_title"
            android:entries="@array/power_menu_type_entries"
            android:entryValues="@array/power_menu_type_values"
            android:defaultValue="0" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_name_monet"
        android:title="@string/category_name_monet">

        <Preference
            android:key="monet_engine"
            android:title="@string/monet_engine_title"
            android:summary="@string/monet_engine_summary"
            android:fragment="org.paranoid.paranoidsettings.fragments.MonetEngine" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_name_style"
        android:title="@string/category_name_style">

        <Preference
            android:key="android.theme.customization.fonts"
            android:icon="@drawable/ic_font"
            android:title="@string/theme_customization_font_title"
            android:summary="@string/theme_customization_font_summary"
            android:fragment="org.paranoid.paranoidsettings.fragments.FontsPicker"/>

        <Preference
            android:key="android.theme.customization.signal_icon"
            android:icon="@drawable/ic_signal"
            android:title="@string/theme_customization_signal_icon_title"
            android:summary="@string/theme_customization_signal_icon_summary"
            android:fragment="org.paranoid.paranoidsettings.fragments.SignalIcons"/>

        <Preference
            android:key="android.theme.customization.wifi_icon"
            android:icon="@drawable/ic_wifi"
            android:title="@string/theme_customization_wifi_icon_title"
            android:summary="@string/theme_customization_wifi_icon_summary"
            android:fragment="org.paranoid.paranoidsettings.fragments.WifiIcons"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="volume_panel_category"
        android:title="@string/volume_panel_title">

        <co.aospa.framework.preference.SecureSettingSwitchPreference
            android:key="volume_panel_on_left"
            android:title="@string/volume_panel_on_left_title"
            android:summary="@string/volume_panel_on_left_summary"
            android:defaultValue="false" />

        <!-- Volume Styles -->
        <co.aospa.framework.preference.SystemSettingListPreference
            android:key="custom_volume_styles"
            android:title="@string/volume_style_title"
            android:icon="@drawable/ic_settings_sound"
            android:entries="@array/volume_styles_entries"
            android:entryValues="@array/volume_styles_values"
            android:summary="%s"
            android:defaultValue="0" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="navbar_category"
        android:title="@string/volume_panel_title">

        <Preference
            android:title="@string/navbar_category"
            android:summary="@string/navbar_tuner_summary" >
            <intent android:action="com.android.settings.action.NAV_BAR_TUNER"
                    android:targetPackage="com.android.systemui"
                    android:targetClass="com.android.systemui.tuner.NavbarActivity" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
